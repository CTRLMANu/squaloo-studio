---
import Base from '../../layouts/Base.astro';
import EntryOpener from '../../components/EntryOpener.astro';
import ThesisPlan from '../../components/ThesisPlan.astro';
import { entries } from '../../data/entries';

const thesis = entries.find((e) => e.slug === 'thesis-kit')!;
const lede =
  'A Cursor workspace for writing a thesis from sources you checked yourself. You open the folder, and it finds papers, checks them, and drafts one section at a time. It only cites papers you have opened and confirmed.';
---

<Base
  title={thesis.title}
  description="thesis-kit is a Cursor workspace for writing a thesis from sources you checked yourself. Clone it, open the folder, and the assistant works from papers you confirmed."
>
  <EntryOpener entry={thesis} lede={lede}>
    <p class="actions">
      <a class="button" href={thesis.url} rel="noopener">Get it on GitHub</a>
    </p>
  </EntryOpener>

  <main class="chapter">
    <section aria-labelledby="does-title">
      <h2 id="does-title" class="rule-under">What it does</h2>
      <ThesisPlan caption="" />
    </section>

    <section aria-labelledby="glance-title">
      <h2 id="glance-title" class="rule-under">At a glance</h2>
      <dl class="facts">
        <div><dt>Status</dt><dd>Live on GitHub. You can use it now. Small parts are still being tightened.</dd></div>
        <div><dt>You write</dt><dd>The thesis stays yours. The kit drafts one section, and you rewrite it in your own words.</dd></div>
        <div><dt>Your files</dt><dd>A thesis folder on your computer. An online backup is optional.</dd></div>
        <div><dt>Alongside</dt><dd>Consensus, Semantic Scholar, ResearchRabbit, Zotero, and Gemini Notebook. All optional.</dd></div>
      </dl>
    </section>
  </main>
</Base>

<style>
  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-xl) var(--space-l);
    padding: var(--space-xl) var(--gutter);
  }

  h2 {
    margin-bottom: var(--space-m);
    padding-bottom: 0.4rem;
    font-family: var(--display);
    font-size: var(--step-3);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  @media (max-width: 60rem) {
    .chapter {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
